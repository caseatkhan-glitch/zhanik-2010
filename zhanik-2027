          console.error('Ошибка отображения уведомления:', err);
        }
      }

      /**
       * Кодирует объект состояния в безопасный base64url для URL-параметра
       */
      function encodeStateToParam(stateObj) {
        const isDefaultLocalPhoto = stateObj.photo === DEFAULT_PHOTO_URL;
        const payload = {
          t: stateObj.title,
          st: stateObj.subtitle,
          w: stateObj.wish,
          s: stateObj.sender,
          c: stateObj.caption,
          g: stateObj.tags,
          // Включаем фото в ссылку, если оно не совпадает с локальным файлом по умолчанию и помещается в URL
          p: !isDefaultLocalPhoto && stateObj.photo && stateObj.photo.length < 18000 ? stateObj.photo : '',
        };
        const jsonStr = JSON.stringify(payload);
        const bytes = new TextEncoder().encode(jsonStr);
        let binary = '';
        for (let i = 0; i < bytes.length; i++) {
          binary += String.fromCharCode(bytes[i]);
        }
        return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
      }

      /**
       * Декодирует параметры из URL (?card=... или отдельные параметры ?title=...&from=...&wish=...)
       */
      function decodeStateFromUrl() {
        try {
          const params = new URLSearchParams(window.location.search);
          const encodedCard = params.get('card');

          if (encodedCard) {
            const base64 = encodedCard.replace(/-/g, '+').replace(/_/g, '/');
            const padded = base64 + '='.repeat((4 - (base64.length % 4)) % 4);
            const binary = atob(padded);
            const bytes = new Uint8Array(binary.length);
            for (let i = 0; i < binary.length; i++) {
              bytes[i] = binary.charCodeAt(i);
            }
            const jsonStr = new TextDecoder().decode(bytes);
            const parsed = JSON.parse(jsonStr);

            return {
              title: typeof parsed.t === 'string' && parsed.t.trim() ? parsed.t.trim() : DEFAULT_STATE.title,
              subtitle: typeof parsed.st === 'string' ? parsed.st : DEFAULT_STATE.subtitle,
              wish: typeof parsed.w === 'string' && parsed.w.trim() ? parsed.w.trim() : DEFAULT_STATE.wish,
              sender: typeof parsed.s === 'string' && parsed.s.trim() ? parsed.s.trim() : DEFAULT_STATE.sender,
              caption: typeof parsed.c === 'string' ? parsed.c : DEFAULT_STATE.caption,
              photo: typeof parsed.p === 'string' && parsed.p.trim() ? parsed.p.trim() : '',
              tags: Array.isArray(parsed.g) && parsed.g.length === 3
                ? parsed.g.map((item, idx) => (typeof item === 'string' && item.trim() ? item.trim() : DEFAULT_STATE.tags[idx]))
                : [...DEFAULT_STATE.tags],
              opened: params.get('open') === '1',
            };
          }

          // Поддержка простых query-параметров вида ?to=Анна&from=Максим&wish=...&photo=...
          const toParam = params.get('to');
          const titleParam = params.get('title');
          const fromParam = params.get('from');
          const wishParam = params.get('wish');
          const photoParam = params.get('photo');
          const subtitleParam = params.get('subtitle');

          if (toParam || titleParam || fromParam || wishParam || photoParam || subtitleParam) {
            return {
              title: titleParam
                ? titleParam
                : toParam
                  ? `С Новым годом, ${toParam}!`
                  : DEFAULT_STATE.title,
              subtitle: subtitleParam || DEFAULT_STATE.subtitle,
              wish: wishParam || DEFAULT_STATE.wish,
              sender: fromParam || DEFAULT_STATE.sender,
              caption: DEFAULT_STATE.caption,
              photo: photoParam || '',
              tags: [...DEFAULT_STATE.tags],
              opened: params.get('open') === '1',
            };
          }

          return null;
        } catch (err) {
          console.warn('Не удалось прочитать параметры ссылки:', err);
          return null;
        }
      }

      /**
       * Формирует актуальную ссылку для шаринга
       */
      function buildShareableUrl() {
        try {
          const url = new URL(window.location.href);
          url.searchParams.delete('to');
          url.searchParams.delete('title');
          url.searchParams.delete('from');
          url.searchParams.delete('wish');
          url.searchParams.delete('photo');
          url.searchParams.delete('subtitle');
          url.searchParams.set('card', encodeStateToParam(currentState));
          return url.toString();
        } catch (err) {
          return window.location.href;
        }
      }

      /**
       * Копирует текст в буфер обмена с fallback через execCommand для iframe
       */
      function copyTextToClipboard(text) {
        if (!text) return;
        if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
          navigator.clipboard.writeText(text).then(
            () => showToast('Ссылка скопирована в буфер обмена!', '🔗'),
            () => fallbackCopy(text)
          );
        } else {
          fallbackCopy(text);
        }
      }

      function fallbackCopy(text) {
        try {
          const tempInput = document.createElement('input');
          tempInput.value = text;
          document.body.appendChild(tempInput);
          tempInput.select();
          document.execCommand('copy');
          document.body.removeChild(tempInput);
          showToast('Ссылка скопирована!', '🔗');
        } catch (err) {
          showToast('Выделите и скопируйте ссылку вручную', '📋');
        }
      }

      /**
       * Сжимает выбранное пользователем фото через Canvas до аккуратного размера,
       * чтобы оно быстро отображалось и помещалось в localStorage/URL без перегрузки.
       */
      function compressImageFile(file, maxSide = 720, quality = 0.78) {
        return new Promise((resolve, reject) => {
          if (!file || !file.type.startsWith('image/')) {
            reject(new Error('Выберите файл изображения'));
            return;
          }

          const reader = new FileReader();
          reader.onload = function (event) {
            const img = new Image();
            img.onload = function () {
              let width = img.width;
              let height = img.height;

              if (width > height && width > maxSide) {
                height = Math.round((height * maxSide) / width);
                width = maxSide;
              } else if (height >= width && height > maxSide) {
                width = Math.round((width * maxSide) / height);
                height = maxSide;
              }

              const canvas = document.createElement('canvas');
              canvas.width = width;
              canvas.height = height;
              const ctx = canvas.getContext('2d');
              if (!ctx) {
                reject(new Error('Не удалось обработать изображение'));
                return;
              }

              ctx.drawImage(img, 0, 0, width, height);
              const dataUrl = canvas.toDataURL('image/jpeg', quality);
              resolve(dataUrl);
            };
            img.onerror = function () {
              reject(new Error('Не удалось загрузить изображение'));
            };
            img.src = event.target.result;
          };
          reader.onerror = function () {
            reject(new Error('Ошибка чтения файла'));
          };
          reader.readAsDataURL(file);
        });
      }

      // =========================================================================
      // 4. СОХРАНЕНИЕ И ЗАГРУЗКА СОСТОЯНИЯ
      // =========================================================================
      function saveState(syncUrl = true) {
        try {
          const toStore = {
            ...currentState,
            opened: undefined,
          };
          localStorage.setItem(STORAGE_KEY, JSON.stringify(toStore));

          if (syncUrl && window.history && typeof window.history.replaceState === 'function') {
            const nextUrl = buildShareableUrl();
            window.history.replaceState(null, '', nextUrl);
          }

          if (dom.shareLinkField) {
            dom.shareLinkField.value = buildShareableUrl();
          }
        } catch (err) {
          console.warn('Не удалось сохранить настройки:', err);
        }
      }

      function loadInitialState() {
        const urlState = decodeStateFromUrl();
        let savedState = null;

        try {
          const raw = localStorage.getItem(STORAGE_KEY);
          if (raw) {
            savedState = JSON.parse(raw);
          }
        } catch (err) {
          console.warn('Не удалось прочитать localStorage:', err);
        }

        if (urlState) {
          currentState = {
            ...DEFAULT_STATE,
            ...(savedState || {}),
            ...urlState,
            photo: urlState.photo || (savedState && savedState.photo) || DEFAULT_PHOTO_URL,
            tags: urlState.tags || (savedState && savedState.tags) || [...DEFAULT_STATE.tags],
          };
          // Если зашли по специальной ссылке с поздравлением, открываем открытку сразу или по кнопке
          if (urlState.opened) {
            currentState.opened = true;
          }
        } else if (savedState) {
          currentState = {
            ...DEFAULT_STATE,
            ...savedState,
            photo: savedState.photo || DEFAULT_PHOTO_URL,
            tags: Array.isArray(savedState.tags) && savedState.tags.length === 3 ? savedState.tags : [...DEFAULT_STATE.tags],
            opened: false,
