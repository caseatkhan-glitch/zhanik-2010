        dom.envelopeRecipientHint.textContent = `Поздравление от: ${currentState.sender || 'Ваш друг'} • Нажмите, чтобы открыть`;

        const activePhoto = currentState.photo && currentState.photo.trim() ? currentState.photo.trim() : DEFAULT_PHOTO_URL;
        dom.displayPhotoImg.src = activePhoto;
        dom.displayPhotoImg.onerror = function () {
          this.onerror = null;
          this.src = FALLBACK_PLACEHOLDER_URL;
        };

        // Отрисовка трёх карточек-акцентов
        const icons = ['✨', '💫', '❄️'];
        const tags = currentState.tags && currentState.tags.length === 3 ? currentState.tags : DEFAULT_STATE.tags;
        dom.displayHighlights.innerHTML = tags
          .map(
            (label, idx) => `
            <div class="rounded-2xl bg-gold/10 border border-gold/20 p-3.5 text-center">
              <div class="text-lg mb-1">${icons[idx] || '🎄'}</div>
              <div class="text-xs sm:text-sm font-medium text-goldBright">${escapeHtml(label)}</div>
