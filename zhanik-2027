          .join('');

        if (dom.shareLinkField) {
          dom.shareLinkField.value = buildShareableUrl();
        }
      }

      function escapeHtml(str) {
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }

      function setCardOpened(isOpened) {
        currentState.opened = Boolean(isOpened);
        if (currentState.opened) {
          dom.envelopeStage.classList.add('hidden');
          dom.greetingCardStage.classList.remove('hidden');
          dom.greetingCardStage.classList.remove('animate-fadeSlideUp');
          void dom.greetingCardStage.offsetWidth;
          dom.greetingCardStage.classList.add('animate-fadeSlideUp');
        } else {
          dom.greetingCardStage.classList.add('hidden');
          dom.envelopeStage.classList.remove('hidden');
          dom.envelopeStage.classList.remove('animate-fadeSlideUp');
          void dom.envelopeStage.offsetWidth;
          dom.envelopeStage.classList.add('animate-fadeSlideUp');
        }
      }

      // =========================================================================
      // 6. МОДАЛЬНОЕ ОКНО НАСТРОЕК И ЗАГРУЗКА ФОТО
      // =========================================================================
      function openEditorModal() {
        dom.titleInput.value = currentState.title;
        dom.senderInput.value = currentState.sender;
        dom.subtitleInput.value = currentState.subtitle;
        dom.captionInput.value = currentState.caption;
        dom.wishInput.value = currentState.wish;

        const tags = currentState.tags || DEFAULT_STATE.tags;
        dom.tag1Input.value = tags[0] || '';
        dom.tag2Input.value = tags[1] || '';
        dom.tag3Input.value = tags[2] || '';

        const currentPhoto = currentState.photo || DEFAULT_PHOTO_URL;
        dom.modalPhotoPreview.src = currentPhoto;
        dom.modalPhotoPreview.onerror = function () {
          this.onerror = null;
          this.src = FALLBACK_PLACEHOLDER_URL;
        };
        dom.photoUrlInput.value =
          currentPhoto.startsWith('data:') || currentPhoto === DEFAULT_PHOTO_URL ? '' : currentPhoto;
        dom.shareLinkField.value = buildShareableUrl();

        dom.editorModal.classList.remove('hidden');
        dom.editorModal.classList.add('flex');
      }

      function closeEditorModal() {
        dom.editorModal.classList.add('hidden');
        dom.editorModal.classList.remove('flex');
      }

      async function handleFileUpload(file) {
        if (!file) return;
        try {
          showToast('Обрабатываем фотографию...', '🖼️');
          const compressedDataUrl = await compressImageFile(file);
          currentState.photo = compressedDataUrl;
          dom.modalPhotoPreview.src = compressedDataUrl;
          dom.photoUrlInput.value = '';
          renderGreeting();
          saveState(true);
          setCardOpened(true);
          showToast('Фото добавлено в открытку!', '🎄');
        } catch (err) {
          showToast(err.message || 'Не удалось загрузить фото', '⚠️');
        }
      }

      // =========================================================================
      // 7. АНИМАЦИЯ ПАДАЮЩЕГО СНЕГА (АДАПТИВНЫЙ CANVAS)
      // =========================================================================
      function initSnowfall() {
        const canvas = document.getElementById('snowCanvas');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        let width = 0;
        let height = 0;
        let snowflakes = [];

        function createFlake(randomY = true) {
          const radius = Math.random() * 2.8 + 1.1;
          return {
            x: Math.random() * width,
            y: randomY ? Math.random() * height : -10,
            r: radius,
            speedY: Math.random() * 0.9 + 0.45 + radius * 0.15,
            drift: Math.random() * 0.6 - 0.3,
            phase: Math.random() * Math.PI * 2,
            opacity: Math.random() * 0.55 + 0.25,
          };
        }

        function resizeCanvas() {
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          width = window.innerWidth;
          height = window.innerHeight;
          canvas.width = Math.floor(width * dpr);
          canvas.height = Math.floor(height * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

          const targetCount = Math.min(120, Math.max(35, Math.floor((width * height) / 14000)));
          if (snowflakes.length === 0) {
            snowflakes = Array.from({ length: targetCount }, () => createFlake(true));
          } else if (snowflakes.length > targetCount) {
            snowflakes = snowflakes.slice(0, targetCount);
          } else {
            while (snowflakes.length < targetCount) {
              snowflakes.push(createFlake(true));
            }
          }
        }

        function drawSnow() {
          ctx.clearRect(0, 0, width, height);

          for (let i = 0; i < snowflakes.length; i++) {
            const flake = snowflakes[i];
            flake.phase += 0.015;
            flake.y += flake.speedY;
            flake.x += flake.drift + Math.sin(flake.phase) * 0.35;

            if (flake.y > height + 12) {
              snowflakes[i] = createFlake(false);
            } else if (flake.x > width + 12) {
              flake.x = -12;
            } else if (flake.x < -12) {
              flake.x = width + 12;
            }

            ctx.beginPath();
            ctx.arc(flake.x, flake.y, flake.r, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(255, 248, 231, ${flake.opacity})`;
            ctx.fill();
          }

          requestAnimationFrame(drawSnow);
        }

        resizeCanvas();
        window.addEventListener('resize', resizeCanvas);
        requestAnimationFrame(drawSnow);
      }

      // =========================================================================
      // 8. ОБРАБОТЧИКИ СОБЫТИЙ
      // =========================================================================
      function bindEvents() {
        // Открытие и закрытие конверта
        dom.openGreetingBtn.addEventListener('click', () => setCardOpened(true));
        dom.envelopeVisual.addEventListener('click', () => setCardOpened(true));
        dom.envelopeVisual.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            setCardOpened(true);
          }
        });
        dom.replayEnvelopeBtn.addEventListener('click', () => setCardOpened(false));

        // Быстрая загрузка фото прямо на открытке
        dom.quickPhotoInput.addEventListener('change', (e) => {
          const file = e.target.files && e.target.files[0];
          if (file) {
            handleFileUpload(file);
            e.target.value = '';
          }
        });

        // Переключение готового пожелания
        dom.cycleWishBtn.addEventListener('click', () => {
          wishCycleIndex = (wishCycleIndex + 1) % SAMPLE_WISHES.length;
          currentState.wish = SAMPLE_WISHES[wishCycleIndex];
          renderGreeting();
          saveState(true);
          showToast('Пожелание обновлено!', '✨');
        });

        // Копирование ссылки
        dom.quickCopyLinkBtn.addEventListener('click', () => {
          copyTextToClipboard(buildShareableUrl());
        });
        dom.shareCardBtn.addEventListener('click', () => {
          copyTextToClipboard(buildShareableUrl());
        });
        dom.modalCopyLinkBtn.addEventListener('click', () => {
          copyTextToClipboard(dom.shareLinkField.value || buildShareableUrl());
        });

        // Открытие / закрытие модального окна настроек
        dom.openEditorBtn.addEventListener('click', openEditorModal);
        dom.closeEditorBtn.addEventListener('click', closeEditorModal);
        dom.editorModal.addEventListener('click', (e) => {
          if (e.target === dom.editorModal) {
            closeEditorModal();
          }
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !dom.editorModal.classList.contains('hidden')) {
            closeEditorModal();
          }
        });

        // Загрузка файла в модальном окне
        dom.modalPhotoFile.addEventListener('change', (e) => {
          const file = e.target.files && e.target.files[0];
          if (file) {
            handleFileUpload(file);
            e.target.value = '';
          }
        });

        // Сброс фото на фото Zhandarbek
        dom.resetPhotoBtn.addEventListener('click', () => {
          currentState.photo = DEFAULT_PHOTO_URL;
          dom.modalPhotoPreview.src = DEFAULT_PHOTO_URL;
          dom.photoUrlInput.value = '';
          renderGreeting();
          saveState(true);
          showToast('Возвращено фото Zhandarbek', '🎄');
        });

        // Вставка примера пожелания в форме
        dom.insertSampleWishBtn.addEventListener('click', () => {
          wishCycleIndex = (wishCycleIndex + 1) % SAMPLE_WISHES.length;
          dom.wishInput.value = SAMPLE_WISHES[wishCycleIndex];
        });

        // Сброс всех настроек к значениям по умолчанию
        dom.restoreDefaultsBtn.addEventListener('click', () => {
          currentState = {
            ...DEFAULT_STATE,
            tags: [...DEFAULT_STATE.tags],
            opened: true,
          };
          renderGreeting();
          saveState(true);
          openEditorModal();
          showToast('Настройки сброшены по умолчанию', '🔄');
        });

        // Сохранение формы
        dom.greetingForm.addEventListener('submit', (e) => {
          e.preventDefault();

          const customUrl = dom.photoUrlInput.value.trim();
          let nextPhoto = currentState.photo || DEFAULT_PHOTO_URL;
          if (customUrl) {
            nextPhoto = customUrl;
          }

          currentState = {
            ...currentState,
            title: dom.titleInput.value.trim() || DEFAULT_STATE.title,
            sender: dom.senderInput.value.trim() || DEFAULT_STATE.sender,
            subtitle: dom.subtitleInput.value.trim() || DEFAULT_STATE.subtitle,
            caption: dom.captionInput.value.trim() || DEFAULT_STATE.caption,
            wish: dom.wishInput.value.trim() || DEFAULT_STATE.wish,
            photo: nextPhoto,
            tags: [
              dom.tag1Input.value.trim() || DEFAULT_STATE.tags[0],
              dom.tag2Input.value.trim() || DEFAULT_STATE.tags[1],
              dom.tag3Input.value.trim() || DEFAULT_STATE.tags[2],
            ],
            opened: true,
          };

          renderGreeting();
          saveState(true);
          setCardOpened(true);
          closeEditorModal();
          showToast('Открытка сохранена, ссылка обновлена!', '🎉');
        });
      }

      // =========================================================================
      // 9. ИНИЦИАЛИЗАЦИЯ ПРИ ЗАГРУЗКЕ СТРАНИЦЫ
      // =========================================================================
      window.addEventListener('DOMContentLoaded', function () {
        loadInitialState();
        renderGreeting();
        saveState(false);
        setCardOpened(Boolean(currentState.opened));
        bindEvents();
        initSnowfall();
      });
    })();
  </script>
</body>
